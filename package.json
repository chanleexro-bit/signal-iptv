{
  "name": "signal-iptv",
  "version": "2.0.0",
  "private": true,
  "description": "Signal IPTV: live TV, movies and series player for M3U playlists and Xtream Codes logins, for Android phones and Android TV",
  "scripts": {
    "build:android": "bash scripts/build-android.sh full",
    "build:play": "bash scripts/build-android.sh play",
    "mock": "python3 tools/mock-xtream/server.py 8099"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "hls.js": "^1.5.13",
    "signal-native-player": "file:native/player"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0"
  }
}
